<% if (flash.error || flash.success) { %>
    <div class="mx-auto w-full max-w-6xl px-6 pt-4">
        <% if (flash.error) { %>
            <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-800" role="alert">
                <%= flash.error %>
            </div>
        <% } %>

        <% if (flash.success) { %>
            <div class="mt-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-800" role="status">
                <%= flash.success %>
            </div>
        <% } %>
    </div>
<% } %>
