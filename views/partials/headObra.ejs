<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.pageTitle ? pageTitle + ' · Océano de Voces' : 'Océano de Voces' %></title>
    <meta name="description" content="Océano de Voces: un cardumen colaborativo hecho de las frases de sus usuarios.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/css/style.css">

    <!-- Usuarios registrados que la ruta /obra serializa desde la base de datos.
         El sketch los lee desde window.usuariosObra para armar el cardumen. -->
    <% if (locals.usuariosObra) { %>
    <script type="text/javascript">
        window.usuariosObra = <%- usuariosObra %>;
    </script>
    <% } %>

    <script type="text/javascript" src="/public/p5/p5.min.js"></script>
    <script type="text/javascript" src="/public/p5/addons/p5.sound.min.js"></script>
    <!-- Primero la clase Cardumen/Pez, después el sketch que la usa -->
    <script type="text/javascript" src="/public/p5/obra/cardumen.js"></script>
    <script type="text/javascript" src="/public/p5/obra/sketch.js"></script>
</head>
<body class="<%= locals.bodyClass || 'bg-marfil text-tinta' %>">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-tinta focus:px-5 focus:py-3 focus:text-xs focus:uppercase focus:tracking-widest focus:text-marfil">Saltar al contenido</a>


