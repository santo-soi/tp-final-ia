<%- include('partials/headObra') %>
<%- include('partials/header') %>
<%- include('partials/flash') %>

<main id="contenido" class="-mb-24" style="margin-bottom: -6rem;">
    <section class="mx-auto w-full">
        <div id="contenedor-canvas-p5" class=" relative w-full h-[95vh] shadow-lg">
            <!-- Un pez por cada usuario registrado: pintado con su color si cargó
                 su voz, en blanco si todavía no la cargó. Sin usuarios, no hay peces. -->

            <!-- Viñeta flotante que muestra la voz del pez clickeado (inicialmente invisible) -->
            <div id="vineta-frase" class="absolute bottom-20 left-1/2 -translate-x-1/2 max-w-md w-[60%] bg-tinta/90 backdrop-blur-md text-marfil px-6 py-4 rounded-2xl shadow-xl opacity-0 transition-opacity duration-300 pointer-events-none z-20">
                <div class="flex items-center gap-4 text-left">
                    <img id="vineta-foto" src="" alt="" class="h-14 w-14 shrink-0 rounded-full border border-marfil/30 object-cover hidden">
                    <div>
                        <p id="vineta-usuario" class="text-xs uppercase tracking-widest text-marfil/60 mb-1"></p>
                        <p id="vineta-texto" class="font-display text-lg italic"></p>
                    </div>
                </div>
            </div>
        </div>

    </section>
</main>

<%- include('partials/foot') %>
