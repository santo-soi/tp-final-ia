<main id="contenido">
    <section class="relative isolate overflow-hidden border-b border-linea">
        <div class="fondo-ola absolute inset-0"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-white/10 via-marfil/40 to-marfil"></div>

        <div class="relative mx-auto flex min-h-[72vh] max-w-6xl flex-col items-center justify-center px-6 py-24 text-center">
            <p class="eyebrow">La obra</p>
            <h1 class="mt-6 max-w-3xl font-display text-5xl leading-[0.95] md:text-7xl">
                El océano todavía<br>
                <span class="italic">está tomando forma.</span>
            </h1>
            <p class="mt-6 max-w-xl text-sm leading-relaxed text-gris md:text-base">
                Acá va a vivir el sketch en p5.js: corrientes de ruido de Perlin, un cardumen de peces geométricos y las voces de la comunidad iluminándose cada 10 segundos.
            </p>

            <div class="mt-10 flex flex-wrap justify-center gap-3">
                <a href="<%= currentUser ? '/user' : '/' %>" class="btn btn-solid">
                    <%= currentUser ? 'Volver a mi espacio' : 'Volver al inicio' %>
                </a>

                <% if (currentUser) { %>
                    <a href="/user/upload" class="btn">Cargar mi voz</a>
                <% } else { %>
                    <a href="/signup" class="btn">Crear mi cuenta</a>
                <% } %>
            </div>
        </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-16">
