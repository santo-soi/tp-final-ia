<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/flash') %>

<main id="contenido" class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-4 border-b border-linea pb-8 md:flex-row md:items-end md:justify-between">
        <div>
            <p class="eyebrow">Mi voz</p>
            <h1 class="mt-3 text-5xl leading-tight md:text-6xl">
                Elegí cómo<br>
                <span class="italic">nada tu pez.</span>
            </h1>
            <p class="mt-4 max-w-xl text-sm leading-relaxed text-gris">
                Tu foto, tu frase y un color. Con eso tu pez entra al cardumen y puede ser iluminado en la obra.
            </p>
        </div>
        <a href="/user" class="btn btn-ghost">← Volver a mi espacio</a>
    </div>

    <form action="/user/upload" method="POST" class="mt-10 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="card space-y-6">

            <div>
                <label for="frase" class="label">Tu frase</label>
                <textarea id="frase" name="frase" rows="4" maxlength="180" class="input resize-none" placeholder="Una frase, una pregunta, un recuerdo..." required><%= currentUser.frase || '' %></textarea>
                <p class="mt-2 text-xs text-gris">Hasta 180 caracteres.</p>
            </div>

            <div>
                <span class="label">Color de tu pez</span>
                <div class="flex flex-wrap gap-3">
                    <% paleta.forEach((color, i) => { %>
                        <label class="color-swatch" title="<%= color.nombre %>">
                            <input type="radio" name="color" value="<%= color.hex %>" <%= (currentUser.tieneVoz && currentUser.color === color.hex) || (!currentUser.tieneVoz && i === 0) ? 'checked' : '' %> required>
                            <span style="background-color: <%= color.hex %>"></span>
                        </label>
                    <% }) %>
                </div>
                <p class="mt-3 text-xs text-gris">Paleta provisoria. Se puede ajustar más adelante.</p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <button type="submit" class="btn btn-solid">Guardar mi voz</button>
                <a href="/user/profile" class="btn btn-ghost">Cancelar</a>
            </div>
        </div>

        <aside class="card flex flex-col justify-between bg-tinta text-marfil">
            <div>
                <p class="text-xs uppercase tracking-[0.2em] text-marfil/60">Vista previa</p>
                <h2 class="mt-4 text-3xl">Tu pez</h2>
                <p class="mt-3 text-sm leading-relaxed text-marfil/70">
                    Cuando cargues tu voz, tu pez nadará en blanco hasta que el océano lo elija. Entonces se pintará con tu color y mostrará tu frase.
                </p>
            </div>

            <div class="mt-10">
                <div class="flex items-center gap-4">
                    <span class="flex h-16 w-16 items-center justify-center rounded-full border border-marfil/30 bg-marfil/10 font-display text-2xl">
                        <%= currentUser.username.charAt(0).toUpperCase() %>
                    </span>
                    <div>
                        <p class="font-display text-2xl"><%= currentUser.username %></p>
                        <p class="text-xs uppercase tracking-[0.18em] text-marfil/60">
                            <%= currentUser.tieneVoz ? 'Voz cargada' : 'Pez en blanco' %>
                        </p>
                    </div>
                </div>
                <p class="mt-6 text-xs leading-relaxed text-marfil/50">
                    La foto y la frase se mostrarán en la viñeta de la obra.
                </p>
            </div>
        </aside>
    </form>
</main>

<%- include('partials/foot') %>
