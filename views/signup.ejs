<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/flash') %>

<main id="contenido" class="mx-auto flex min-h-[70vh] max-w-6xl items-center px-6 py-16">
    <div class="grid w-full gap-12 md:grid-cols-2 md:items-center">
        <div>
            <p class="eyebrow">Registrarme</p>
            <h1 class="mt-4 text-5xl leading-tight md:text-6xl">
                Entrá al<br>
                <span class="italic">océano.</span>
            </h1>
            <p class="mt-6 max-w-md text-sm leading-relaxed text-gris dark:text-slate-400">
                Creá tu cuenta para tener tu propio pez. Después vas a poder elegir tu foto, tu frase y el color con el que se ilumina en la obra.
            </p>
        </div>

        <div class="card">
            <form action="/signup" method="POST" class="space-y-5">
                <div>
                    <label for="username" class="label">Usuario</label>
                    <input id="username" name="username" type="text" class="input" autocomplete="username" minlength="3" maxlength="20" pattern="[A-Za-z0-9_]+" required>
                    <p class="mt-2 text-xs text-gris dark:text-slate-400">Entre 3 y 20 caracteres: letras, números o guión bajo. Después lo podés cambiar desde tu perfil.</p>
                </div>

                <div>
                    <label for="password" class="label">Contraseña</label>
                    <input id="password" name="password" type="password" class="input" autocomplete="new-password" minlength="8" required>
                    <p class="mt-2 text-xs text-gris dark:text-slate-400">Mínimo 8 caracteres.</p>
                </div>

                <div>
                    <label for="confirmPassword" class="label">Repetir contraseña</label>
                    <input id="confirmPassword" name="confirmPassword" type="password" class="input" autocomplete="new-password" minlength="8" required>
                </div>

                <button type="submit" class="btn btn-solid w-full">Crear mi cuenta</button>
            </form>

            <p class="mt-6 text-center text-sm text-gris dark:text-slate-400">
                ¿Ya tenés cuenta?
                <a href="/login" class="link-underline text-tinta dark:text-marfil">Ingresá</a>
            </p>
        </div>
    </div>
</main>

<%- include('partials/foot') %>
